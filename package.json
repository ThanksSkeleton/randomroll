{
  "name": "randomroll",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "vite",
    "build": "npm run json && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "json": "npm run powers_json && npm run names_json && npm run lucky_json && npm run items_json && npm run professions_json && npm run weapons_json && npm run xcc_celebrity_headshots_json && npm run xcc_movie_names_json",
    "powers_json": "tsx scripts/from_sql.ts data/randomroll.sqlite powers src/table_data",
    "names_json": "tsx scripts/from_sql.ts data/randomroll.sqlite names src/table_data",
    "lucky_json": "tsx scripts/from_sql.ts data/randomroll.sqlite Lucky src/table_data",
    "items_json": "tsx scripts/from_sql.ts data/randomroll.sqlite Items src/table_data",
    "professions_json": "tsx scripts/from_sql.ts data/randomroll.sqlite Professions src/table_data",
    "weapons_json": "tsx scripts/from_sql.ts data/randomroll.sqlite Weapons src/table_data",
    "xcc_celebrity_headshots_json": "tsx scripts/from_sql.ts data/randomroll.sqlite xcc_celebrity_headshots src/table_data",
    "xcc_movie_names_json": "tsx scripts/from_sql.ts data/randomroll.sqlite xcc_movie_names src/table_data"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^7.0.0",
    "html2canvas": "^1.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "seedrandom": "^3.0.5",
    "vitest": "^4.1.8"
  }
}
